# Image runtime sans build Next.js dans Docker (build sur l'hôte).
# Usage : cd frontend && npm run build && cd .. && docker compose -f docker-compose.yml -f docker-compose.local-build.yml up --build -d frontend

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

COPY public ./public
COPY .next/standalone ./
COPY .next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
