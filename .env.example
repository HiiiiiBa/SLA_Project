# PostgreSQL
POSTGRES_DB=sla_monitoring
POSTGRES_USER=sla_user
POSTGRES_PASSWORD=sla_password
# Leave empty to keep PostgreSQL internal-only (recommended with docker compose).
# Set e.g. 5434 if you need host access and 5433 is already used by sla-postgres.
POSTGRES_PORT=

# Backend
BACKEND_PORT=8080
JWT_SECRET=sla-monitoring-jwt-secret-key-change-in-production-min-256-bits
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_DEMO_SEED_ENABLED=true
SLA_SIMULATION_ENABLED=true

# Frontend (URLs seen by the browser, not inside Docker network)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# MailHog
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
