# PostgreSQL
POSTGRES_DB=sla_monitoring
POSTGRES_USER=sla_user
POSTGRES_PASSWORD=change-me-strong-password
# Leave empty to keep PostgreSQL internal-only (recommended with docker compose).
POSTGRES_PORT=

# Backend
BACKEND_PORT=8080
JWT_SECRET=change-me-jwt-secret-key-min-256-bits-for-production
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Demo seed: keep false for enterprise delivery
APP_DEMO_SEED_ENABLED=false
SLA_SIMULATION_ENABLED=false

# Assistant IA (clé serveur uniquement — ne jamais exposer au frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true

# Frontend (URLs seen by the browser, not inside Docker network)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# Mail (MailHog en local / SMTP entreprise en production)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
